   "source": [
    "import aerosandbox as asb \n",
    "from NumOpt import Opti \n",
    "\n",
    "opti=Opti()\n",
    "h=opti.variable(init_guess=0.0,lower_bound=0.0) \n",
    "atms=asb.Atmosphere(altitude=h)\n",
    "\n",
    "sos=atms.speed_of_sound()\n",
    "mu=atms.dynamic_viscosity()\n",
    "rho=atms.sur"
   ]
  }
